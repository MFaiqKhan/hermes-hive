#!/usr/bin/env bash
# datactl: a tiny stand-in for an internal tool whose error message does not say how to fix it.
STATE="${HERMES_HOME:-$HOME}/datactl-state"
case "$1" in
  --help|-h|help)
    echo "datactl 2.3 - sync local records"
    echo "usage: datactl sync [--rebuild-index] | datactl status | datactl cache verify"
    echo "  sync --rebuild-index   rebuild the local cache index first (needed after an upgrade)";;
  cache)
    if [ "$2" = verify ]; then [ -f "$STATE/index" ] && echo "index ok" || { echo "index: bad magic" >&2; exit 3; }; exit 0; fi
    echo "usage: datactl cache verify" >&2; exit 2;;
  sync|status)
    for a in "${@:2}"; do
      case "$a" in
        --rebuild-index) [ "$1" = sync ] || { echo "usage: datactl status" >&2; exit 2; }
                         mkdir -p "$STATE"; echo ok > "$STATE/index"; echo "cache index rebuilt (1,204 entries)";;
        *) echo "datactl: unknown option $a" >&2; exit 2;;
      esac
    done
    if [ ! -f "$STATE/index" ]; then echo "datactl: error: cache index is corrupt or missing (code 17)" >&2; exit 17; fi
    echo "synced 42 records";;
  *) echo "usage: datactl sync [--rebuild-index] | status | cache verify" >&2; exit 2;;
esac
